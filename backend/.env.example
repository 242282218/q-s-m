# Core
LOG_LEVEL=INFO
DEFAULT_LANG=zh-CN
HTTP_PROXY=

# TMDB
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/

# Quark Search
QUARK_SEARCH_API_PREFIX=/api/quark
QUARK_SEARCH_BASE_URL=https://b.funletu.com
QUARK_SEARCH_MAX_RETRIES=3
QUARK_SEARCH_RATE_LIMIT=0.5
QUARK_SEARCH_TIMEOUT=10
QUARK_SEARCH_CONFIDENCE_WEIGHT=0.7
QUARK_SEARCH_QUALITY_WEIGHT=0.3
QUARK_SEARCH_MAX_RESULTS=20

# Cache
CACHE_ENABLED=true
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Quark Auth
QUARK_COOKIE=
QUARK_TRANSFER_COOKIE=

# Transfer Behavior
# Whether to keep extras videos (trailers/behind-the-scenes/NCOP/NCED etc.)
TRANSFER_KEEP_EXTRAS=false
# Whether to keep subtitle files during cleanup (.srt/.ass/.ssa/.sub/.vtt)
TRANSFER_KEEP_SUBTITLES=false
# Dry-run mode: only simulate move/rename/delete, no real mutation
TRANSFER_DRY_RUN=false
# Enable cleanup stage after reorganizing videos
TRANSFER_CLEANUP_ENABLED=true
# Cleanup toggles
TRANSFER_CLEANUP_DELETE_NON_VIDEO=true
TRANSFER_CLEANUP_DELETE_UNSELECTED_VIDEO=true
TRANSFER_CLEANUP_DELETE_EMPTY_DIRS=true

# Media Root Directories
BASE_MOVIE_DIR=/影视收藏/电影
BASE_TV_DIR=/影视收藏/电视剧
BASE_ANIME_DIR=/影视收藏/动漫
BASE_DOCUMENTARY_DIR=/影视收藏/纪录片
