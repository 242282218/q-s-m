# Core
ENV=production
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=storage/logs

# Optional path overrides
QSM_STORAGE_ROOT=storage
QSM_DATA_DIR=storage/db
QSM_RUNTIME_ENV_FILE=storage/config/settings.env

# API authentication
API_KEY=replace-with-a-long-random-string

# TMDB
TMDB_API_KEY=replace-with-your-tmdb-api-key
DEFAULT_LANG=zh-CN
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/
HTTP_PROXY=

# Frontend build args
VITE_API_BASE=/api/v1
# Leave empty by default. If you set this to the same value as API_KEY,
# the key will be embedded into the built frontend bundle.
VITE_API_KEY=

# Quark search
QUARK_SEARCH_API_PREFIX=/api/quark
QUARK_SEARCH_BASE_URL=https://b.funletu.com
QUARK_SEARCH_MAX_RETRIES=3
QUARK_SEARCH_RATE_LIMIT=0.5
QUARK_SEARCH_TIMEOUT=10
QUARK_SEARCH_CONFIDENCE_WEIGHT=0.7
QUARK_SEARCH_QUALITY_WEIGHT=0.3
QUARK_SEARCH_MAX_RESULTS=20

# Cache
CACHE_ENABLED=true
# Set to redis to enable cross-process cache and rate limiting consistency.
CACHE_TYPE=memory
REDIS_URL=redis://redis:6379/0
# Cooldown window after a Redis limiter failure. During cooldown, limiter falls back to memory only.
RATE_LIMIT_REDIS_FAILURE_COOLDOWN_SECONDS=30
# Trust proxy headers for real client IP extraction in rate limiter.
TRUST_PROXY_HEADERS=false
# Only headers from these proxy source IPs are trusted.
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
CACHE_TTL=3600

# Quark transfer
QUARK_TRANSFER_COOKIE=replace-with-your-quark-cookie

# Transfer behavior
TRANSFER_KEEP_EXTRAS=false
TRANSFER_KEEP_SUBTITLES=false
TRANSFER_DRY_RUN=false
TRANSFER_CLEANUP_ENABLED=true
TRANSFER_CLEANUP_DELETE_NON_VIDEO=true
TRANSFER_CLEANUP_DELETE_UNSELECTED_VIDEO=true
TRANSFER_CLEANUP_DELETE_EMPTY_DIRS=true

# Media root directories
BASE_MOVIE_DIR=/影视收藏/电影
BASE_TV_DIR=/影视收藏/电视剧
BASE_ANIME_DIR=/影视收藏/动漫
BASE_DOCUMENTARY_DIR=/影视收藏/纪录片

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Runtime
DEBUG=false
