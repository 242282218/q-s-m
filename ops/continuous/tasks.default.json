{
  "tasks": [
    {
      "name": "backend_pytest",
      "module": "backend",
      "cwd": "backend",
      "command": ["python", "-m", "pytest"],
      "agent": {
        "name": "backend-agent",
        "model": "gpt-5.4"
      },
      "timeout": 1800,
      "enabled": true
    },
    {
      "name": "frontend_lint_check",
      "module": "frontend",
      "cwd": "frontend",
      "command": ["pnpm", "run", "lint:check"],
      "agent": {
        "name": "frontend-agent",
        "model": "gpt-5.4"
      },
      "timeout": 900,
      "enabled": true
    },
    {
      "name": "frontend_format_check",
      "module": "frontend",
      "cwd": "frontend",
      "command": ["pnpm", "run", "format:check"],
      "agent": {
        "name": "frontend-agent",
        "model": "gpt-5.4"
      },
      "timeout": 900,
      "enabled": true
    },
    {
      "name": "frontend_vitest",
      "module": "frontend",
      "cwd": "frontend",
      "command": ["pnpm", "test"],
      "agent": {
        "name": "frontend-agent",
        "model": "gpt-5.4"
      },
      "timeout": 1200,
      "enabled": true
    },
    {
      "name": "frontend_build",
      "module": "frontend",
      "cwd": "frontend",
      "command": ["pnpm", "build"],
      "agent": {
        "name": "frontend-agent",
        "model": "gpt-5.4"
      },
      "timeout": 900,
      "enabled": true
    },
    {
      "name": "performance_benchmark",
      "module": "performance",
      "cwd": "backend",
      "command": [
        "python",
        "../tests/performance/benchmark.py",
        "--output-json",
        "--output-path",
        "storage/logs/continuous/performance/latest.json",
        "--fail-on-threshold-breach"
      ],
      "agent": {
        "name": "performance-agent",
        "model": "gpt-5.4"
      },
      "timeout": 900,
      "enabled": true
    }
  ]
}
